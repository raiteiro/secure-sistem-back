<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- WebDAV intercepts OPTIONS requests before they reach the app and responds
           without CORS headers, which looks identical to a CORS misconfiguration in
           the browser console. Removing it is safe even if it isn't the cause here. -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SecureSistem.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ConnectionStrings__DefaultConnection" value="Server=50.21.190.109;Database=secsistem;User Id=rodrigo.rangel;Password=B2ba177c;TrustServerCertificate=True" />
          <environmentVariable name="Jwt__Key" value="oCU68rie5Hrmpl1Ego1itovisk1TjY7J7CcF5rivsWhm9caiU010ZtWqaGZ+++Ov" />
          <environmentVariable name="Cors__AllowedOrigins__0" value="https://corepv.nokmosis.net" />
          <environmentVariable name="Frontend__BaseUrl" value="https://corepv.nokmosis.net" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
